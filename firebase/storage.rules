rules_version = '2';
// Silk: each signed-in user may read and write only their own two files.
// Everything in them is already encrypted on the device; these rules just keep strangers out
// and cap the size. Deploy with: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    match /vaults/{uid}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid
                  && (file == 'keyslot.skvk' || file == 'vault.skln' || file == 'vault.interim');
      allow create, update: if request.auth != null && request.auth.uid == uid
                  && (file == 'keyslot.skvk' || file == 'vault.skln' || file == 'vault.interim')
                  && request.resource.size < 20 * 1024 * 1024;
      allow delete: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
